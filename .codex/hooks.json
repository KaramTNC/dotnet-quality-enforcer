{
  "description": "Portable safety and context hooks for foundation-generated repositories.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \".codex/hooks/scripts/session-context.ps1\"",
            "timeout": 10,
            "statusMessage": "Loading project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \".codex/hooks/scripts/inspect-command.ps1\"",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \".codex/hooks/scripts/validate-turn.ps1\"",
            "timeout": 20,
            "statusMessage": "Checking final worktree state"
          }
        ]
      }
    ]
  }
}

